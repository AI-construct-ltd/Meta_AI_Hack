# Firebase Authentication & Firestore (AIConstruct apprentice login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Gemini API configuration (All AI features run on Gemini)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_MODEL="gemini-3.8-flash"

# Optional: Gemini model overrides
# GEMINI_TEXT_MODEL=gemini-3.8-flash,gemini-4-argon
# GEMINI_VISION_MODEL=gemini-3.8-flash,gemini-4-argon
# GEMINI_PLAN_MODEL=gemini-3.8-flash,gemini-4-argon

# Optional: the public URL, used for share cards, the sitemap and canonical links.
# NEXT_PUBLIC_SITE_URL=https://aiconstruct.uk

# Optional: manual scanner at /scan
# NEXT_PUBLIC_SCAN=1
