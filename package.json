{
  "name": "aiconstruct",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "mkdir -p .next/standalone/public && cp -r public/* .next/standalone/public/ 2>/dev/null || true",
    "start": "next start",
    "lint": "eslint",
    "voice": "node --experimental-transform-types --no-warnings --import ./scripts/voice/register.mjs scripts/voice/record.ts",
    "voice:names": "node --experimental-transform-types --no-warnings --import ./scripts/voice/register.mjs scripts/voice/names.ts",
    "voice:check": "node --experimental-transform-types --no-warnings --import ./scripts/voice/register.mjs scripts/voice/listen-check.ts",
    "ikea:fetch": "node --experimental-transform-types --no-warnings scripts/ikea/fetch.ts",
    "ikea:build": "node --experimental-transform-types --no-warnings --import ./scripts/voice/register.mjs scripts/ikea/build.ts",
    "ikea:check": "node --experimental-transform-types --no-warnings --import ./scripts/voice/register.mjs scripts/ikea/check.ts",
    "textbook:build": "node --experimental-transform-types --no-warnings --import ./scripts/voice/register.mjs scripts/textbook/build.ts",
    "textbook:check": "node --experimental-transform-types --no-warnings --import ./scripts/voice/register.mjs scripts/textbook/check.ts",
    "textbook:upgrade": "node --experimental-transform-types --no-warnings --import ./scripts/voice/register.mjs scripts/textbook/upgrade.ts",
    "textbook:expand": "node --experimental-transform-types --no-warnings --import ./scripts/voice/register.mjs scripts/textbook/expand.ts",
    "textbook:audit": "node --experimental-transform-types --no-warnings --import ./scripts/voice/register.mjs scripts/textbook/audit.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@vercel/analytics": "^1.6.1",
    "firebase": "^13.1.0",
    "lucide-react": "1.54.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "vercel": "^65.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  }
}
